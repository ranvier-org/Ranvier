<Project>
    <!-- The wire suite, in compile order. Ranvier.Wire.Tests and fable/Ranvier.Tests.Fable both compile it. -->
    <ItemGroup>
        <Compile Include="$(MSBuildThisFileDirectory)WireSupport.fs" Link="WireSupport.fs" />
        <Compile Include="$(MSBuildThisFileDirectory)VendoredThoth.fs" Link="VendoredThoth.fs" />
        <Compile Include="$(MSBuildThisFileDirectory)WireDecoding.fs" Link="WireDecoding.fs" />
        <Compile Include="$(MSBuildThisFileDirectory)NumericDecoding.fs" Link="NumericDecoding.fs" />
    </ItemGroup>
</Project>
