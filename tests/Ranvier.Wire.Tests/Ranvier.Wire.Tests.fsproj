<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
    </PropertyGroup>

    <Import Project="WireTestFiles.props" />

    <ItemGroup>
        <Compile Include="Main.fs" />
        <None Include="ecma-numbers.txt" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Expecto" Version="11.1.1" />
        <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.16.1" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Ranvier.Wire\Ranvier.Wire.fsproj" />
    </ItemGroup>
</Project>
