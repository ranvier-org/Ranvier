        <Compile Include="HostTests.fs" />
        <Compile Include="MountTests.fs" />
        <Compile Include="InputTests.fs" />
        <Compile Include="PaintTests.fs" />
        <Compile Include="Main.fs" />
    </ItemGroup>
    <ItemGroup>
