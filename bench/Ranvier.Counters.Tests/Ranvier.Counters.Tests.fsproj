<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="LinuxPmcTests.fs" />
    <Compile Include="NodeRunsTests.fs" />
    <Compile Include="WorkerTests.fs" />
    <Compile Include="AbTests.fs" />
    <Compile Include="CompareTests.fs" />
    <Compile Include="HistoryTests.fs" />
    <Compile Include="TraceGrowthTests.fs" />
    <Compile Include="TraceReportTests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" Version="11.1.1" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.16.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Ranvier.Counters/Ranvier.Counters.fsproj" />
  </ItemGroup>
</Project>
