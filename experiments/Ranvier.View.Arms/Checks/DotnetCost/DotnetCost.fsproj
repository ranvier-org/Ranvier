<Project Sdk="Microsoft.NET.Sdk">
  <!-- The .NET costs of Arms.Match in a fresh process: the first site's lowering, later lowerings, and server renders of a 1,000-row site against its armOf twin. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Main.fs" />
    <ProjectReference Include="../../Ranvier.View.Arms.fsproj" />
    <PackageReference Update="FSharp.Core" Version="10.1.401" />
  </ItemGroup>
</Project>
