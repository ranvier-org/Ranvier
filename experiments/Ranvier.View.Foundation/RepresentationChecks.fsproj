<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Fixtures.fs" />
    <Compile Include="../Ranvier.View.Portable/Checks/PackagingChecks.fs" Link="Checks/PackagingChecks.fs" />
    <Compile Include="../Ranvier.View.Portable/Checks/ServerFixtures.fs" Link="Checks/ServerFixtures.fs" />
    <Compile Include="../Ranvier.View.Portable/Checks/ServerChecks.fs" Link="Checks/ServerChecks.fs" />
    <Compile Include="../Ranvier.View.Portable/Checks/SugarFixtures.fs" Link="Checks/SugarFixtures.fs" />
    <Compile Include="../Ranvier.View.Portable/Checks/SugarServerChecks.fs" Link="Checks/SugarServerChecks.fs" />
    <Compile Include="../Ranvier.View.Arms/Checks/ArmsFixtures.fs" Link="Checks/ArmsFixtures.fs" />
    <Compile Include="../Ranvier.View.Arms/Checks/ArmsServerChecks.fs" Link="Checks/ArmsServerChecks.fs" />
    <Compile Include="../Ranvier.View.Arms/Checks/ArmsLoweringChecks.fs" Link="Checks/ArmsLoweringChecks.fs" />
    <Compile Include="RepresentationChecks.fsx" />
    <ProjectReference Include="../Ranvier.View.Portable/Ranvier.View.Portable.fsproj" />
    <ProjectReference Include="../Ranvier.View.Arms/Ranvier.View.Arms.fsproj" />
    <PackageReference Update="FSharp.Core" Version="10.1.401" />
  </ItemGroup>
</Project>
